/* MR048 — REVERT ENDFILE clears ON handler */
P: PROC OPTIONS(MAIN);
  DCL X FIXED BIN(31);
  DCL Y FIXED BIN(31);
  ON ENDFILE(SYSIN) GOTO BAD;
  GET LIST(X);
  REVERT ENDFILE(SYSIN);
  GET LIST(Y);
  PUT LIST(X);
  PUT LIST(Y);
  PUT LIST('ok');
  RETURN;
  BAD: PUT LIST('bad');
END P;
