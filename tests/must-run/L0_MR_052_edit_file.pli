/* MR052 — PUT/GET EDIT FILE(f) round-trip */
P: PROC OPTIONS(MAIN);
  DCL N FIXED BIN(31);
  DCL S CHAR(3);
  OPEN FILE(F) OUTPUT STREAM TITLE('mr052.dat');
  PUT FILE(F) EDIT (42, 'ABC') (F(3), X(1), A(3));
  CLOSE FILE(F);
  OPEN FILE(F) INPUT STREAM TITLE('mr052.dat');
  GET FILE(F) EDIT (N, S) (F(3), X(1), A(3));
  CLOSE FILE(F);
  PUT LIST(N);
  PUT SKIP LIST(S);
END P;
