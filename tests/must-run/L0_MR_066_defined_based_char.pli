/* MR066 — DEFINED CHAR + DEFINED on BASED FIXED */
P: PROC OPTIONS(MAIN);
  DCL B CHAR(2);
  DCL C CHAR(2) DEFINED(B);
  DCL P POINTER;
  DCL X FIXED BIN(31) BASED(P);
  DCL Y FIXED BIN(31) DEFINED(X);
  B = 'hi';
  ALLOCATE X SET(P);
  X = 5;
  PUT LIST(C);
  PUT SKIP LIST(Y);
  FREE X;
END P;
