/* MR050 — ON ENDFILE(FILE) BEGIN … GOTO + GET FILE EOF */
P: PROC OPTIONS(MAIN);
  DCL X FIXED BIN(31);
  OPEN FILE(IN1) OUTPUT STREAM TITLE('mr050.dat');
  PUT FILE(IN1) LIST(1, 2, 3);
  CLOSE FILE(IN1);
  OPEN FILE(IN1) INPUT STREAM TITLE('mr050.dat');
  ON ENDFILE(IN1) BEGIN;
    PUT LIST('eof');
    GOTO DONE;
  END;
  DO WHILE (1);
    GET FILE(IN1) LIST(X);
    PUT LIST(X);
  END;
  DONE: ;
  CLOSE FILE(IN1);
END P;
