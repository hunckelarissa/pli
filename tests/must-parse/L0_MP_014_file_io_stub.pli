/* MP014 — FILE(f) on GET/PUT + REVERT parse stubs */
P: PROC OPTIONS(MAIN);
  DCL X FIXED BIN(31);
  OPEN FILE(F) INPUT STREAM;
  GET FILE(F) LIST(X);
  PUT FILE(F) LIST(X);
  PUT FILE(SYSPRINT) SKIP LIST('ok');
  GET FILE(SYSIN) LIST(X);
  REVERT ENDFILE(SYSIN);
  CLOSE FILE(F);
END P;
