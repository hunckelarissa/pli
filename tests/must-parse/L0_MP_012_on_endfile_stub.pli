/* MP012 — ON ENDFILE / OPEN / CLOSE parse stubs (exec later) */
P: PROC OPTIONS(MAIN);
  DONE: ;
  ON ENDFILE(SYSIN) GOTO DONE;
  ON ENDFILE(SYSIN) SNAP;
  ON ENDFILE(SYSIN) BEGIN;
    PUT LIST('eof');
  END;
  ON ENDFILE(SYSIN);
  OPEN FILE(F) INPUT STREAM TITLE('x.dat') ENV(FB);
  CLOSE FILE(F);
END P;
